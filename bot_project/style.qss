/* Catppuccin Mocha / Modern Dark Theme para o ChatBot */
QMainWindow {
    background-color: #181825;
    color: #cdd6f4;
    font-family: 'Segoe UI', Arial, sans-serif;
}

QWidget {
    color: #cdd6f4;
    font-family: 'Segoe UI', Arial, sans-serif;
}

/* Header */
#headerWidget {
    background-color: #1e1e2e;
    border-radius: 14px;
    padding: 10px 16px;
    border: 1px solid #313244;
}

/* Scroll Area do Chat */
QScrollArea {
    border: 1px solid #313244;
    background-color: #1e1e2e;
    border-radius: 14px;
}

QScrollBar:vertical {
    border: none;
    background: #1e1e2e;
    width: 8px;
    margin: 6px 2px 6px 0;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #45475a;
    min-height: 25px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #585b70;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Campo de Texto (Input) */
QLineEdit {
    background-color: #24253a;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 14px;
}

QLineEdit:focus {
    border: 1px solid #89b4fa;
    background-color: #292a42;
}

/* Botão Enviar */
QPushButton#sendButton {
    background-color: #89b4fa;
    color: #11111b;
    border: none;
    border-radius: 12px;
    padding: 12px 22px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#sendButton:hover {
    background-color: #b4befe;
}

QPushButton#sendButton:pressed {
    background-color: #74c7ec;
}

/* Botão Seletor de Humor (abre para cima) */
QPushButton#moodButton {
    background-color: #24253a;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#moodButton:hover {
    background-color: #313244;
    border: 1px solid #89b4fa;
}

QPushButton#moodButton:pressed {
    background-color: #45475a;
}

/* Menu Popup de Humor */
QMenu {
    background-color: #24253a;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 10px;
    padding: 6px;
    font-size: 13px;
}

QMenu::item {
    padding: 8px 18px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #3e487a;
    color: #ffffff;
}

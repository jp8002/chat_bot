from PySide6.QtWidgets import QApplication, QMainWindow, QLabel, QWidget, QScrollArea, QHBoxLayout, QLineEdit, QPushButton, QSizePolicy

QMainWindow {
                background-color: #1e1e2e;
}
QScrollArea {
    border: none;
    background-color: #1e1e2e;
}

QLineEdit {
    background-color: #41425c;
    color: #cdd6f4;
    border: 1px solid #41425c;
    border-radius: 12px;
    padding: 10px 15px;
    font-size: 14px;
}

QLineEdit:focus {
    border: 1px solid #ab7a5e;
}

QPushButton {
    background-color: #89b4fa;
    color: #11111b;
    border: none;
    border-radius: 12px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #b4befe;
}
QPushButton:pressed {
    background-color: #74c7ec;
}